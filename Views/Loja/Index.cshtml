@model List<OTAKON.Models.Produto>

@{
    ViewData["Title"] = "OTAKON - Loja de Mangás";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <div class="text-center mb-4">
        <img src="~/images/OTAPanda.png" alt="OTAKON Logo" class="logo-principal" />
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var produto in Model)
        {
            <div class="col">
                <div class="card h-100 text-center shadow-sm rounded">
                    <img src="@produto.Imagem" class="card-img-top" style="height: 300px; object-fit: cover;" alt="@produto.Nome" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@produto.Nome</h5>
                        <p class="card-text mb-1"><strong>Autor:</strong> @produto.Autor</p>
                        <p class="card-text mb-1"><strong>Distribuidora:</strong> @produto.Editora</p>
                        <p class="card-text fw-bold mb-3"><strong>Preço:</strong> € @produto.Preco.ToString("F2")</p>
                        <a asp-action="Detalhe" asp-route-id="@produto.IDProduto" class="mt-auto">
                            <button class="btn-compra w-100">Ver Mais</button>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>