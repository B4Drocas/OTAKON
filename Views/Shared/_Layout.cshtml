</head>
<body class="otakon-theme">
    <header>
        <nav class="navbar border-bottom otakon-navbar">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <!-- Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/OTAKON - Cópia.png" alt="OTAKON Logo" style="height: 40px;" />
                </a>

                <!-- Botões: Idioma e Menu Hamburger -->
                <div style="display: flex; gap: 15px; align-items: center;">
                    <!-- Dropdown de Idioma -->
                    <div class="otakon-language-dropdown">
                        <button class="otakon-language-btn" onclick="toggleLanguageDropdown()">
                            🌐 <span data-i18n="language">LANGUAGE</span>
                        </button>
                        <div class="otakon-language-dropdown-menu">
                            <a href="javascript:void(0)" class="otakon-language-option" data-lang="pt" onclick="setLanguage('pt')">
                                🇵🇹 Português
                            </a>
                            <a href="javascript:void(0)" class="otakon-language-option" data-lang="en" onclick="setLanguage('en')">
                                🇬🇧 English
                            </a>
                        </div>
                    </div>

                    <!-- Menu Hamburger -->
                    <button class="otakon-menu-toggle" id="menuToggle" onclick="toggleOtakonMenu()">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Menu Sidebar -->
        <div class="otakon-menu" id="otakonMenu">
            <div class="otakon-menu-content">
                <!-- Seção Principal -->
                <h5 class="otakon-menu-section" data-i18n="navegacao">NAVEGAÇÃO</h5>
                <a href="/" class="otakon-menu-item" data-i18n="home" onclick="closeOtakonMenu()">🏠 HOME</a>
                <a href="/Loja/Index" class="otakon-menu-item" data-i18n="loja" onclick="closeOtakonMenu()">🛍️ LOJA</a>
                <a href="/Info/Index" class="otakon-menu-item" data-i18n="sobre" onclick="closeOtakonMenu()">ℹ️ SOBRE</a>
                <a href="/Home/Privacy" class="otakon-menu-item" data-i18n="privacidade" onclick="closeOtakonMenu()">🔒 PRIVACIDADE</a>

                <!-- Divisor -->
                <div style="border-top: 1px solid var(--border-color); margin: 20px 0;"></div>

                <!-- Seção de Autenticação -->
                @if (Context.Session.GetInt32("UserId") == null)
                {
                    <h5 class="otakon-menu-section" data-i18n="conta">CONTA</h5>
                    <a href="/Account/Login" class="otakon-menu-item otakon-menu-login" data-i18n="login" onclick="closeOtakonMenu()">🔐 LOGIN</a>
                    <a href="/Account/Register" class="otakon-menu-item" data-i18n="registrar" onclick="closeOtakonMenu()">✍️ REGISTRAR</a>
                }
                else
                {
                    <!-- Seção do Usuário Autenticado -->
                    <h5 class="otakon-menu-section">👤 @Context.Session.GetString("Username")</h5>

                    <a href="/Account/Dashboard" class="otakon-menu-item" data-i18n="dashboard" onclick="closeOtakonMenu()">📊 DASHBOARD</a>
                    <a href="/Profile/Index" class="otakon-menu-item" data-i18n="perfil" onclick="closeOtakonMenu()">👥 MEU PERFIL</a>
                    <a href="/Account/Dashboard" class="otakon-menu-item" data-i18n="carrinho" onclick="closeOtakonMenu()">🛒 CARRINHO</a>
                    <a href="/Account/Favorites" class="otakon-menu-item" data-i18n="favorito" onclick="closeOtakonMenu()">⭐ FAVORITOS</a>
                    <a href="/Account/Settings" class="otakon-menu-item" data-i18n="configuracoes" onclick="closeOtakonMenu()">⚙️ CONFIGURAÇÕES</a>

                    <!-- Divisor -->
                    <div style="border-top: 1px solid var(--border-color); margin: 20px 0;"></div>

                    <a href="/Account/Logout" class="otakon-menu-item otakon-menu-logout" data-i18n="logout" onclick="closeOtakonMenu()">🚪 SAIR</a>
                }
            </div>
        </div>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OTAKON - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
