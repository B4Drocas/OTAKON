@{
    ViewData["Title"] = "Meu Perfil - OTAKON";
}

<div style="background-color: var(--bg-primary); min-height: 100vh; padding: 60px 20px;">
    <div style="max-width: 1000px; margin: 0 auto;">

        <!-- Cabeçalho -->
        <div style="margin-bottom: 60px; text-align: center;">
            <h1 data-i18n="meuPerfil" style="color: var(--text-primary); font-size: 3em; font-weight: 900; margin-bottom: 15px;">
                MEU PERFIL
            </h1>
            <p data-i18n="gerenciarDados" style="color: var(--text-secondary); font-size: 1.1em;">
                Gerencie suas informações e preferências
            </p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 2.5fr; gap: 40px;">
            <!-- Sidebar com Avatar -->
            <div style="background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); padding: 30px; border-radius: 12px; box-shadow: 0 4px 16px rgba(220, 53, 69, 0.15); height: fit-content;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="width: 120px; height: 120px; margin: 0 auto 20px; background: linear-gradient(135deg, #dc3545 0%, #ff6b6b 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 50px; font-weight: 900; box-shadow: 0 4px 16px rgba(220, 53, 69, 0.3);">
                        👤
                    </div>
                    <h3 style="color: var(--text-primary); font-size: 1.3em; margin: 0 0 10px 0; font-weight: 700;">
                        João Silva
                    </h3>
                    <p style="color: var(--text-tertiary); margin: 0 0 20px 0; font-size: 0.9em;">
                        Membro desde Dezembro 2024
                    </p>
                    <div style="display: flex; gap: 10px; justify-content: center;">
                        <span style="background: rgba(220, 53, 69, 0.2); color: var(--accent); padding: 6px 12px; border-radius: 20px; font-size: 0.85em; font-weight: 600;">
                            ⭐ Premium
                        </span>
                    </div>
                </div>

                <div style="border-top: 2px solid var(--border-color); padding-top: 20px; margin-top: 20px;">
                    <div style="margin-bottom: 20px;">
                        <p style="color: var(--text-tertiary); font-size: 0.85em; text-transform: uppercase; margin: 0 0 8px 0; font-weight: 600;">
                            Estatísticas
                        </p>
                        <div style="display: flex; justify-content: space-between;">
                            <div style="text-align: center;">
                                <div style="font-size: 1.5em; font-weight: 900; color: var(--accent);">12</div>
                                <div style="color: var(--text-tertiary); font-size: 0.85em; margin-top: 5px;">Compras</div>
                            </div>
                            <div style="text-align: center;">
                                <div style="font-size: 1.5em; font-weight: 900; color: var(--accent);">28</div>
                                <div style="color: var(--text-tertiary); font-size: 0.85em; margin-top: 5px;">Favoritos</div>
                            </div>
                            <div style="text-align: center;">
                                <div style="font-size: 1.5em; font-weight: 900; color: var(--accent);">5</div>
                                <div style="color: var(--text-tertiary); font-size: 0.85em; margin-top: 5px;">Avaliações</div>
                            </div>
                        </div>
                    </div>
                </div>

                <button style="width: 100%; background: var(--gradient-accent); color: white; border: none; padding: 12px 20px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; margin-top: 20px; transition: all 0.3s ease;" onmouseover="this.style.boxShadow='0 4px 16px rgba(220, 53, 69, 0.3)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='none'; this.style.transform='translateY(0)'">
                    Mudar Avatar
                </button>
            </div>

            <!-- Conteúdo Principal -->
            <div>
                <!-- Tabs de Navegação -->
                <div style="display: flex; gap: 20px; margin-bottom: 40px; border-bottom: 2px solid var(--border-color); overflow-x: auto;">
                    <button class="profile-tab active" onclick="switchTab('dados')" style="padding: 15px 0; color: var(--accent); border-bottom: 3px solid var(--accent); font-weight: 700; text-transform: uppercase; cursor: pointer; background: none; border: none; transition: all 0.3s ease; white-space: nowrap;">
                        Dados Pessoais
                    </button>
                    <button class="profile-tab" onclick="switchTab('seguranca')" style="padding: 15px 0; color: var(--text-tertiary); border-bottom: 3px solid transparent; font-weight: 700; text-transform: uppercase; cursor: pointer; background: none; border: none; transition: all 0.3s ease; white-space: nowrap;">
                        Segurança
                    </button>
                    <button class="profile-tab" onclick="switchTab('notificacoes')" style="padding: 15px 0; color: var(--text-tertiary); border-bottom: 3px solid transparent; font-weight: 700; text-transform: uppercase; cursor: pointer; background: none; border: none; transition: all 0.3s ease; white-space: nowrap;">
                        Notificações
                    </button>
                    <button class="profile-tab" onclick="switchTab('privacidade')" style="padding: 15px 0; color: var(--text-tertiary); border-bottom: 3px solid transparent; font-weight: 700; text-transform: uppercase; cursor: pointer; background: none; border: none; transition: all 0.3s ease; white-space: nowrap;">
                        Privacidade
                    </button>
                </div>

                <!-- Aba 1: Dados Pessoais -->
                <div id="tab-dados" class="profile-tab-content" style="display: block;">
                    <h2 style="color: var(--text-primary); font-size: 1.5em; margin-bottom: 25px;">Informações Pessoais</h2>

                    <form style="display: grid; gap: 25px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Nome Completo
                                </label>
                                <input type="text" value="João Silva" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Data de Nascimento
                                </label>
                                <input type="date" value="1995-05-15" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Email
                                </label>
                                <input type="email" value="joao@example.com" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Telefone
                                </label>
                                <input type="tel" value="+351 912 345 678" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                        </div>

                        <div>
                            <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                Endereço
                            </label>
                            <input type="text" value="Rua do Exemplo, 123, Pombal, 3100-000" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Cidade
                                </label>
                                <input type="text" value="Pombal" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    País
                                </label>
                                <input type="text" value="Portugal" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                        </div>

                        <div style="display: flex; gap: 15px; margin-top: 20px;">
                            <button type="button" style="background: var(--gradient-accent); color: white; border: none; padding: 14px 35px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(220, 53, 69, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                                Salvar Alterações
                            </button>
                            <button type="button" style="background: transparent; color: var(--text-secondary); border: 2px solid var(--border-color); padding: 12px 35px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)'" onmouseout="this.style.borderColor='var(--border-color)'; this.style.color='var(--text-secondary)'">
                                Cancelar
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Aba 2: Segurança -->
                <div id="tab-seguranca" class="profile-tab-content" style="display: none;">
                    <h2 style="color: var(--text-primary); font-size: 1.5em; margin-bottom: 25px;">Segurança</h2>

                    <div style="background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); padding: 25px; border-radius: 12px; border-left: 4px solid var(--accent); margin-bottom: 25px;">
                        <h3 style="color: var(--text-primary); font-size: 1.1em; margin: 0 0 15px 0; font-weight: 700;">Alterar Senha</h3>
                        <form style="display: grid; gap: 20px;">
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Senha Atual
                                </label>
                                <input type="password" placeholder="Digite sua senha atual" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-primary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Nova Senha
                                </label>
                                <input type="password" placeholder="Digite uma nova senha" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-primary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <div>
                                <label style="font-weight: 700; color: var(--text-primary); text-transform: uppercase; font-size: 0.9em; display: block; margin-bottom: 10px;">
                                    Confirmar Nova Senha
                                </label>
                                <input type="password" placeholder="Confirme a nova senha" style="width: 100%; padding: 14px; border: 2px solid var(--border-color); border-radius: 8px; background: var(--bg-primary); color: var(--text-primary); font-weight: 500; transition: all 0.3s ease;" onfocus="this.style.borderColor='var(--accent)'; this.style.boxShadow='0 0 0 3px rgba(220, 53, 69, 0.1)'" onblur="this.style.borderColor='var(--border-color)'; this.style.boxShadow='none'" />
                            </div>
                            <button type="button" style="background: var(--gradient-accent); color: white; border: none; padding: 14px 35px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease; align-self: flex-start;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(220, 53, 69, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                                Atualizar Senha
                            </button>
                        </form>
                    </div>

                    <div style="background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); padding: 25px; border-radius: 12px; border-left: 4px solid var(--accent);">
                        <h3 style="color: var(--text-primary); font-size: 1.1em; margin: 0 0 15px 0; font-weight: 700;">Autenticação de Dois Fatores</h3>
                        <p style="color: var(--text-secondary); margin: 0 0 15px 0;">Aumente a segurança da sua conta ativando a autenticação de dois fatores.</p>
                        <button type="button" style="background: transparent; color: var(--accent); border: 2px solid var(--accent); padding: 12px 35px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='var(--accent)'; this.style.color='white'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--accent)'">
                            Ativar 2FA
                        </button>
                    </div>
                </div>

                <!-- Aba 3: Notificações -->
                <div id="tab-notificacoes" class="profile-tab-content" style="display: none;">
                    <h2 style="color: var(--text-primary); font-size: 1.5em; margin-bottom: 25px;">Preferências de Notificações</h2>

                    <div style="background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); padding: 25px; border-radius: 12px; margin-bottom: 20px;">
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" checked style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Notificações por Email</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" checked style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Atualizações de Produtos</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Ofertas Especiais</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer;">
                            <input type="checkbox" checked style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Mensagens da Comunidade</span>
                        </label>
                    </div>

                    <button type="button" style="background: var(--gradient-accent); color: white; border: none; padding: 14px 35px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 16px rgba(220, 53, 69, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                        Salvar Preferências
                    </button>
                </div>

                <!-- Aba 4: Privacidade -->
                <div id="tab-privacidade" class="profile-tab-content" style="display: none;">
                    <h2 style="color: var(--text-primary); font-size: 1.5em; margin-bottom: 25px;">Privacidade</h2>

                    <div style="background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%); padding: 25px; border-radius: 12px; margin-bottom: 20px;">
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" checked style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Perfil Público</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" checked style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Permitir Mensagens</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 15px; cursor: pointer; margin-bottom: 15px;">
                            <input type="checkbox" style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent);" />
                            <span style="color: var(--text-primary); font-weight: 600;">Compartilhar Atividade</span>
                        </label>
                    </div>

                    <div style="background: linear-gradient(135deg, rgba(220,53,69,0.1) 0%, rgba(220,53,69,0.05) 100%); padding: 25px; border-radius: 12px; border-left: 4px solid var(--accent);">
                        <h3 style="color: var(--accent); font-size: 1.1em; margin: 0 0 15px 0; font-weight: 700;">Zona de Perigo</h3>
                        <p style="color: var(--text-secondary); margin: 0 0 20px 0;">Essas ações são irreversíveis. Por favor, tenha cuidado.</p>
                        <button type="button" style="background: rgba(220,53,69,0.9); color: white; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='rgba(220,53,69,1)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.backgroundColor='rgba(220,53,69,0.9)'; this.style.transform='translateY(0)'">
                            Excluir Conta
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
function switchTab(tabName) {
  // Esconder todos os tabs
  const tabs = document.querySelectorAll('.profile-tab-content');
  tabs.forEach(tab => {
    tab.style.display = 'none';
  });

  // Mostrar tab selecionado
  const selectedTab = document.getElementById('tab-' + tabName);
  if (selectedTab) {
    selectedTab.style.display = 'block';
  }

  // Atualizar botões ativos
  const buttons = document.querySelectorAll('.profile-tab');
  buttons.forEach(btn => {
    btn.style.color = 'var(--text-tertiary)';
    btn.style.borderBottomColor = 'transparent';
  });

  event.target.style.color = 'var(--accent)';
  event.target.style.borderBottomColor = 'var(--accent)';
}
</script>

<style>
  .profile-tab {
    position: relative;
    color: var(--text-tertiary);
  }

  .profile-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent) !important;
  }

  .profile-tab-content {
    animation: fadeInUp 0.4s ease;
  }

  @@media (max-width: 768px) {
    div[style*="grid-template-columns: 1fr 2.5fr"] {
      grid-template-columns: 1fr !important;
    }

    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }

    h1 {
      font-size: 2em !important;
    }
  }
</style>
