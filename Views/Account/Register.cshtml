@{
    ViewData["Title"] = "Registrar - OTAKON";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/otakon-brutal.css" asp-append-version="true" />
    <script src="~/js/language.js" asp-append-version="true"></script>
</head>
<body class="otakon-theme" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; position: relative;">
    <!-- Efeito de ruído -->
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.02), rgba(255,255,255,.02) 1px, transparent 1px, transparent 2px); pointer-events: none; z-index: -1;"></div>

    <div style="width: 100%; max-width: 550px; position: relative; z-index: 2;">
        <div style="background: var(--bg-secondary); border: 2px solid var(--accent); overflow: hidden; animation: slideUp 0.5s ease; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); position: relative;">
            <!-- Top Border -->
            <div style="height: 2px; background: var(--accent);"></div>

            <!-- Header -->
            <div style="padding: 50px 30px; text-align: center; color: var(--text-primary); border-bottom: 2px solid var(--border-color);">
                <img src="~/images/OTAKON - Cópia.png" alt="OTAKON Logo" style="max-width: 150px; height: auto; margin-bottom: 20px;" />
                <h2 data-i18n="registrar" style="margin: 0; font-weight: 900; font-size: 2.5em; color: var(--text-primary); text-transform: uppercase; letter-spacing: -1px;">
                    REGISTRAR
                </h2>
                <p data-i18n="junteseComunidade" style="margin: 15px 0 0 0; color: var(--text-tertiary); font-size: 0.95em; font-weight: 600; letter-spacing: 0.5px;">
                    JUNTE-SE À COMUNIDADE OTAKON
                </p>
            </div>

            <!-- Language Selector -->
            <div style="padding: 10px 30px; text-align: right; background: rgba(220, 53, 69, 0.05); border-bottom: 1px solid var(--border-color);">
                <div class="otakon-language-selector" style="display: flex; gap: 8px; justify-content: flex-end; align-items: center; margin: 0;">
                    <button class="otakon-lang-btn" onclick="setLanguage('pt')" id="langPt" title="Português" style="background: none; border: none; color: var(--text-primary); font-weight: 900; font-size: 0.8em; text-transform: uppercase; cursor: pointer; padding: 5px 10px; border-radius: 4px; transition: all 0.3s ease;">PT</button>
                    <span style="color: var(--border-color); font-weight: 300;">|</span>
                    <button class="otakon-lang-btn" onclick="setLanguage('en')" id="langEn" title="English" style="background: none; border: none; color: var(--text-primary); font-weight: 900; font-size: 0.8em; text-transform: uppercase; cursor: pointer; padding: 5px 10px; border-radius: 4px; transition: all 0.3s ease;">EN</button>
                </div>
            </div>

            <!-- Body -->
            <div style="padding: 40px 30px;">
                @if (ViewData["ErrorMessage"] != null)
                {
                    <div style="background-color: rgba(220, 53, 69, 0.2); color: var(--text-primary); padding: 15px; border-radius: 6px; margin-bottom: 25px; border-left: 5px solid var(--accent); font-size: 0.95em; font-weight: 600; border: 2px solid var(--accent);">
                        ⚠️ @ViewData["ErrorMessage"]
                    </div>
                }

                @if (ViewData["SuccessMessage"] != null)
                {
                    <div style="background-color: rgba(40, 167, 69, 0.2); color: var(--text-primary); padding: 15px; border-radius: 6px; margin-bottom: 25px; border-left: 5px solid #28a745; font-size: 0.95em; font-weight: 600; border: 2px solid #28a745;">
                        ✅ @ViewData["SuccessMessage"]
                    </div>
                }

                <form method="post" action="/Account/Register">
                    <div style="margin-bottom: 20px;">
                        <label for="fullName" data-i18n="nomeCompleto" style="font-weight: 900; color: var(--text-primary); margin-bottom: 12px; display: block; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.5px;">
                            Nome Completo
                        </label>
                        <input type="text" class="form-control" id="fullName" name="fullName" 
                               data-i18n-attr="placeholder" data-i18n-key="nomeCompletoPlaceholder" placeholder="Digite seu nome completo" />
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label for="username" data-i18n="usuario" style="font-weight: 900; color: var(--text-primary); margin-bottom: 12px; display: block; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.5px;">
                            Usuário
                        </label>
                        <input type="text" class="form-control" id="username" name="username" 
                               data-i18n-attr="placeholder" data-i18n-key="usuarioPlaceholder" placeholder="Escolha um usuário único" required />
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label for="email" data-i18n="email" style="font-weight: 900; color: var(--text-primary); margin-bottom: 12px; display: block; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.5px;">
                            Email
                        </label>
                        <input type="email" class="form-control" id="email" name="email" 
                               data-i18n-attr="placeholder" data-i18n-key="emailPlaceholder" placeholder="seu@email.com" required />
                    </div>

                    <div style="margin-bottom: 20px;">
                        <label for="password" data-i18n="senha" style="font-weight: 900; color: var(--text-primary); margin-bottom: 12px; display: block; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.5px;">
                            Senha
                        </label>
                        <input type="password" class="form-control" id="password" name="password" 
                               data-i18n-attr="placeholder" data-i18n-key="senhaPlaceholder" placeholder="Mínimo 6 caracteres" required />
                    </div>

                    <div style="margin-bottom: 30px;">
                        <label for="passwordConfirm" data-i18n="confirmarSenha" style="font-weight: 900; color: var(--text-primary); margin-bottom: 12px; display: block; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.5px;">
                            Confirmar Senha
                        </label>
                        <input type="password" class="form-control" id="passwordConfirm" name="passwordConfirm" 
                               data-i18n-attr="placeholder" data-i18n-key="confirmarSenhaPlaceholder" placeholder="Repita sua senha" required />
                    </div>

                    <button type="submit" class="btn btn-danger w-100 otakon-btn" data-i18n="criarContaAgora" style="padding: 15px; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px;">
                        Criar Conta Agora
                    </button>

                    <div style="text-align: center; padding-top: 25px; border-top: 2px solid var(--border-color); color: var(--text-tertiary); font-size: 0.95em; font-weight: 600;">
                        <span data-i18n="temConta">Já tem conta?</span>
                        <a href="/Account/Login" data-i18n="facaLogin" style="color: var(--accent); text-decoration: none; font-weight: 900; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 0.5px;">Faça Login</a>
                    </div>
                </form>
            </div>

            <!-- Theme Toggle Button -->
            <div style="padding: 20px 30px; text-align: center; border-top: 2px solid var(--border-color);">
                <button id="theme-toggle" class="btn btn-outline-danger btn-sm" style="font-weight: 900; text-transform: uppercase; letter-spacing: 1px; border-width: 2px;">
                    <span id="theme-icon">🌙</span> <span data-i18n="tema">Tema</span>
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
</body>
</html>
