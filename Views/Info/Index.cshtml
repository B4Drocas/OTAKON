@{
    ViewData["Title"] = "Sobre OTAKON";
}

<div style="background: linear-gradient(135deg, #0a0e27 0%, #1a1a2e 50%, #16213e 100%); min-height: 100vh; padding: 0; position: relative; overflow: hidden;">
    <!-- Animated Background Elements -->
    <div style="position: absolute; width: 400px; height: 400px; background: radial-gradient(circle, rgba(220,53,69,0.15) 0%, transparent 70%); border-radius: 50%; top: -100px; right: -100px; animation: float 6s ease-in-out infinite;"></div>
    <div style="position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(255,107,107,0.1) 0%, transparent 70%); border-radius: 50%; bottom: 50px; left: -150px; animation: float 8s ease-in-out infinite;"></div>

    <div style="max-width: 1200px; margin: 0 auto; padding: 80px 20px; position: relative; z-index: 2;">

        <!-- Header Section - BRUTAL -->
        <div style="text-align: center; margin-bottom: 100px;">
            <div style="display: inline-block; position: relative; margin-bottom: 30px;">
                <h1 style="font-size: 4.5em; color: #fff; margin: 0; font-weight: 900; letter-spacing: -2px; text-transform: uppercase; text-shadow: 0 10px 30px rgba(220, 53, 69, 0.5);">
                    OTAKON
                </h1>
                <div style="height: 6px; background: linear-gradient(90deg, #dc3545, #ff6b6b, #ffa07a); margin-top: 15px; box-shadow: 0 0 20px rgba(220, 53, 69, 0.6);"></div>
            </div>
            <p style="font-size: 1.4em; color: #ff6b6b; margin-top: 20px; font-weight: 600; letter-spacing: 1px;">
                MANGÁS ÉPICOS. ENTREGA GLOBAL. SEM COMPROMISSOS.
            </p>
        </div>

        <!-- Pombal Section - BRUTAL -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-bottom: 80px; align-items: center;">
            <div style="background: rgba(255, 255, 255, 0.05); border: 2px solid rgba(220, 53, 69, 0.5); padding: 50px; backdrop-filter: blur(10px); border-radius: 15px; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 0; width: 5px; height: 100%; background: linear-gradient(180deg, #dc3545, #ff6b6b);"></div>
                <h2 style="color: #ff6b6b; margin-bottom: 25px; font-size: 2.2em; font-weight: 900; text-transform: uppercase; letter-spacing: 1px;">⚡ Nossa Origem</h2>
                <p style="font-size: 1.15em; line-height: 1.9; color: #e0e0e0; margin-bottom: 15px; font-weight: 500;">
                    100% PORTUGUESA. 100% REAL. 100% PAIXÃO.
                </p>
                <p style="font-size: 1.1em; line-height: 1.8; color: #b0b0b0;">
                    Nascida em <strong style="color: #ff6b6b;">Pombal</strong>, Portugal, a OTAKON é mais que uma loja—é um movimento. Aqui, a tradição portuguesa encontra a energia vibrante dos mangás. Cada título que passamos é uma declaração de guerra à qualidade mediocre.
                </p>
            </div>
            <div style="background: linear-gradient(135deg, #dc3545, #ff6b6b); padding: 50px; border-radius: 15px; text-align: center; position: relative; box-shadow: 0 20px 60px rgba(220, 53, 69, 0.4); transform: perspective(1000px) rotateY(-5deg);">
                <div style="font-size: 5em; margin-bottom: 20px; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.3));">🇵🇹</div>
                <h3 style="font-size: 2em; margin-bottom: 15px; font-weight: 900; text-transform: uppercase;">POMBAL</h3>
                <p style="font-size: 1.2em; margin-bottom: 10px; font-weight: 700;">PORTUGAL</p>
                <p style="font-size: 1em; opacity: 0.95; font-weight: 600;">Onde os heróis nascem</p>
            </div>
        </div>

        <!-- Eurodollar Section - BRUTAL -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-bottom: 80px; align-items: center;">
            <div style="background: linear-gradient(135deg, #1e90ff, #0052a3); padding: 50px; border-radius: 15px; text-align: center; position: relative; box-shadow: 0 20px 60px rgba(30, 144, 255, 0.3); transform: perspective(1000px) rotateY(5deg);">
                <div style="font-size: 5em; margin-bottom: 20px; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.3));">€</div>
                <h3 style="font-size: 2em; margin-bottom: 15px; font-weight: 900; text-transform: uppercase;">EURODOLAR</h3>
                <p style="font-size: 1.2em; margin-bottom: 10px; font-weight: 700;">MOEDA DE REFERÊNCIA</p>
                <p style="font-size: 1em; opacity: 0.95; font-weight: 600;">Preços nítidos, sem truques</p>
            </div>
            <div style="background: rgba(30, 144, 255, 0.1); border: 2px solid rgba(30, 144, 255, 0.5); padding: 50px; backdrop-filter: blur(10px); border-radius: 15px; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; right: 0; width: 5px; height: 100%; background: linear-gradient(180deg, #1e90ff, #0052a3);"></div>
                <h2 style="color: #1e90ff; margin-bottom: 25px; font-size: 2.2em; font-weight: 900; text-transform: uppercase; letter-spacing: 1px;">💎 Transparência Total</h2>
                <p style="font-size: 1.15em; line-height: 1.9; color: #e0e0e0; margin-bottom: 15px; font-weight: 500;">
                    ZERO SURPRESAS NO CHECKOUT.
                </p>
                <p style="font-size: 1.1em; line-height: 1.8; color: #b0b0b0;">
                    Trabalhamos exclusivamente em <strong style="color: #1e90ff;">Eurodolar (€)</strong>. Sem conversões escondidas. Sem taxas ocultas. O preço que vê é o preço que paga. Simples. Direto. Brutal.
                </p>
            </div>
        </div>

        <!-- Global Delivery Section - BRUTAL -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; margin-bottom: 80px; align-items: center;">
            <div style="background: rgba(40, 167, 69, 0.1); border: 2px solid rgba(40, 167, 69, 0.5); padding: 50px; backdrop-filter: blur(10px); border-radius: 15px; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 0; width: 5px; height: 100%; background: linear-gradient(180deg, #28a745, #20c997);"></div>
                <h2 style="color: #20c997; margin-bottom: 25px; font-size: 2.2em; font-weight: 900; text-transform: uppercase; letter-spacing: 1px;">🚀 Sem Fronteiras</h2>
                <p style="font-size: 1.15em; line-height: 1.9; color: #e0e0e0; margin-bottom: 15px; font-weight: 500;">
                    ENTREGAMOS EM QUALQUER LUGAR.
                </p>
                <p style="font-size: 1.1em; line-height: 1.8; color: #b0b0b0;">
                    Se você respira, a gente entrega. Não importa se é Lisboa, Tóquio ou Marte—seus mangás chegam em perfeitas condições. Parcerias logísticas confiáveis, rastreamento completo, segurança garantida.
                </p>
            </div>
            <div style="background: linear-gradient(135deg, #28a745, #20c997); padding: 50px; border-radius: 15px; text-align: center; position: relative; box-shadow: 0 20px 60px rgba(40, 167, 69, 0.3); transform: perspective(1000px) rotateY(-5deg);">
                <div style="font-size: 5em; margin-bottom: 20px; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.3));">🌍</div>
                <h3 style="font-size: 2em; margin-bottom: 15px; font-weight: 900; text-transform: uppercase;">COBERTURA GLOBAL</h3>
                <p style="font-size: 1.2em; margin-bottom: 10px; font-weight: 700;">PARA TODO O UNIVERSO</p>
                <p style="font-size: 1em; opacity: 0.95; font-weight: 600;">Rápido. Seguro. Impiedoso.</p>
            </div>
        </div>

        <!-- Footer Info - BRUTAL -->
        <div style="margin-top: 100px; padding-top: 50px; border-top: 2px solid rgba(220, 53, 69, 0.3);">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px;">
                <div style="background: rgba(220, 53, 69, 0.1); border-left: 4px solid #dc3545; padding: 30px; border-radius: 10px;">
                    <h3 style="color: #ff6b6b; margin-bottom: 15px; font-size: 1.4em; font-weight: 900; text-transform: uppercase;">📍 Base</h3>
                    <p style="color: #d0d0d0; line-height: 2; font-size: 1.05em; font-weight: 600;">
                        Pombal<br>
                        Portugal<br>
                        Europa
                    </p>
                </div>
                <div style="background: rgba(30, 144, 255, 0.1); border-left: 4px solid #1e90ff; padding: 30px; border-radius: 10px;">
                    <h3 style="color: #1e90ff; margin-bottom: 15px; font-size: 1.4em; font-weight: 900; text-transform: uppercase;">💳 Moeda</h3>
                    <p style="color: #d0d0d0; line-height: 2; font-size: 1.05em; font-weight: 600;">
                        Eurodolar (€)<br>
                        Sem Surpresas<br>
                        Sem Intermediários
                    </p>
                </div>
                <div style="background: rgba(40, 167, 69, 0.1); border-left: 4px solid #28a745; padding: 30px; border-radius: 10px;">
                    <h3 style="color: #20c997; margin-bottom: 15px; font-size: 1.4em; font-weight: 900; text-transform: uppercase;">🌐 Alcance</h3>
                    <p style="color: #d0d0d0; line-height: 2; font-size: 1.05em; font-weight: 600;">
                        Cobertura Mundial<br>
                        Rastreamento Completo<br>
                        Garantia Brutal
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(20px);
        }
    }

    @@media (max-width: 768px) {
        h1 {
            font-size: 2.5em !important;
        }

        h2 {
            font-size: 1.6em !important;
        }

        div[style*="grid-template-columns: 1fr 1fr"] {
            grid-template-columns: 1fr !important;
        }

        div[style*="transform: perspective"] {
            transform: none !important;
        }
    }
</style>
