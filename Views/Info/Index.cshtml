@{
    ViewData["Title"] = "Sobre Nós - OTAKON";
}

<div style="background-color: var(--bg-primary); min-height: 100vh; padding: 60px 20px;">
    <div style="max-width: 1000px; margin: 0 auto;">

        <!-- Cabeçalho -->
        <div style="margin-bottom: 80px; text-align: center; border-bottom: 3px solid var(--accent); padding-bottom: 40px;">
            <h1 data-i18n="sobreOtakon" style="color: var(--text-primary); font-size: 3.5em; font-weight: 900; margin: 0 0 15px 0; text-transform: uppercase; letter-spacing: -2px;">
                SOBRE OTAKON
            </h1>
            <p data-i18n="comunidadePortuguesa" style="color: var(--text-secondary); font-size: 1.2em; margin: 0; font-weight: 600;">
                Uma Comunidade Portuguesa Apaixonada por Mangá
            </p>
        </div>

        <!-- Seção 1: Quem Somos -->
        <section style="margin-bottom: 80px;">
            <div style="background-color: rgba(220, 53, 69, 0.08); padding: 50px; border-radius: 8px; border-left: 5px solid var(--accent);">
                <h2 data-i18n="quemSomos" style="color: var(--text-primary); font-size: 2.2em; font-weight: 900; margin: 0 0 25px 0; text-transform: uppercase; letter-spacing: 0.5px;">
                    ⚡ Quem Somos
                </h2>
                <p data-i18n="quemSomosTexto1" style="color: var(--text-secondary); font-size: 1.1em; line-height: 1.9; margin: 0 0 20px 0;">
                    A OTAKON nasceu em Pombal, Portugal, com uma missão simples mas poderosa: trazer os melhores mangás do mundo para leitores portugueses apaixonados por história, arte e cultura.
                </p>
                <p data-i18n="quemSomosTexto2" style="color: var(--text-secondary); font-size: 1.1em; line-height: 1.9; margin: 0;">
                    Não somos apenas uma loja. Somos uma comunidade de fãs genuínos que acreditam no poder transformador de um bom mangá. Cada livro que vendemos é uma declaração de qualidade.
                </p>
            </div>
        </section>

        <!-- Seção 2: Nossa Missão -->
        <section style="margin-bottom: 80px;">
            <h2 data-i18n="nossaMissao" style="color: var(--text-primary); font-size: 2.2em; font-weight: 900; margin-bottom: 40px; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">
                💎 Nossa Missão
            </h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
                <div style="background-color: rgba(30, 144, 255, 0.08); padding: 40px; border-radius: 8px; border-top: 3px solid #1e90ff;">
                    <h3 data-i18n="qualidade" style="color: #1e90ff; font-size: 1.3em; font-weight: 900; margin: 0 0 15px 0; text-transform: uppercase;">Qualidade</h3>
                    <p data-i18n="qualidadeDesc" style="color: var(--text-secondary); font-size: 1em; line-height: 1.8; margin: 0;">
                        Cada mangá é selecionado com cuidado. Oferecemos apenas os melhores títulos, com tradução de qualidade e edições originais.
                    </p>
                </div>

                <div style="background-color: rgba(40, 167, 69, 0.08); padding: 40px; border-radius: 8px; border-top: 3px solid #28a745;">
                    <h3 data-i18n="transparencia" style="color: #28a745; font-size: 1.3em; font-weight: 900; margin: 0 0 15px 0; text-transform: uppercase;">Transparência</h3>
                    <p data-i18n="transparenciaDesc" style="color: var(--text-secondary); font-size: 1em; line-height: 1.8; margin: 0;">
                        Sem conversões ocultas. Sem taxas surpresa. O preço que você vê é o preço que paga. Simples e honesto.
                    </p>
                </div>

                <div style="background-color: rgba(220, 53, 69, 0.08); padding: 40px; border-radius: 8px; border-top: 3px solid var(--accent);">
                    <h3 data-i18n="comunidade" style="color: var(--accent); font-size: 1.3em; font-weight: 900; margin: 0 0 15px 0; text-transform: uppercase;">Comunidade</h3>
                    <p data-i18n="comunidadeDesc" style="color: var(--text-secondary); font-size: 1em; line-height: 1.8; margin: 0;">
                        Você faz parte de algo maior. Conheça outros leitores, compartilhe recomendações e descubra novos mangás.
                    </p>
                </div>

                <div style="background-color: rgba(255, 193, 7, 0.08); padding: 40px; border-radius: 8px; border-top: 3px solid #ffc107;">
                    <h3 data-i18n="entregaGlobal" style="color: #ffc107; font-size: 1.3em; font-weight: 900; margin: 0 0 15px 0; text-transform: uppercase;">Entrega Global</h3>
                    <p data-i18n="entregaGlobalDesc" style="color: var(--text-secondary); font-size: 1em; line-height: 1.8; margin: 0;">
                        Portugal, Europa, Mundo. Seus mangás chegam em perfeitas condições, com rastreamento e garantia total.
                    </p>
                </div>
            </div>
        </section>

        <!-- Seção 3: Por Que Escolher OTAKON -->
        <section style="margin-bottom: 80px;">
            <h2 data-i18n="porQueEscolher" style="color: var(--text-primary); font-size: 2.2em; font-weight: 900; margin-bottom: 40px; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">
                🎯 Por Que Escolher OTAKON
            </h2>

            <div style="background-color: var(--bg-secondary); padding: 50px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="raizesPortuguesas">Raízes Portuguesas - Pombal é nossa casa, e o português é nosso idioma</span>
                    </li>
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="catalogoVasto">Catálogo Vasto - Clássicos, novidades, rarezas - sempre em stock</span>
                    </li>
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="atendimentoPessoal">Atendimento Pessoal - Faça perguntas, peça recomendações, somos acessíveis</span>
                    </li>
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="precosJustos">Preços Justos - Competitivos e honestos, sem surpresas</span>
                    </li>
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="entregaRapida">Entrega Rápida - Embalagem segura, rastreamento completo</span>
                    </li>
                    <li style="color: var(--text-secondary); font-size: 1.05em; line-height: 1.8; padding-left: 40px; position: relative;">
                        <span style="position: absolute; left: 0; color: var(--accent); font-weight: 900; font-size: 1.2em;">✓</span>
                        <span data-i18n="comunidadeAtiva">Comunidade Ativa - Participe de discussões e eventos</span>
                    </li>
                </ul>
            </div>
        </section>

        <!-- Seção 4: Nossos Valores -->
        <section style="margin-bottom: 80px;">
            <h2 data-i18n="nossosValores" style="color: var(--text-primary); font-size: 2.2em; font-weight: 900; margin-bottom: 40px; text-transform: uppercase; letter-spacing: 0.5px; text-align: center;">
                🛡️ Nossos Valores
            </h2>

            <div style="background-color: rgba(220, 53, 69, 0.08); padding: 50px; border-radius: 8px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px;">
                    <div style="text-align: center;">
                        <h3 style="color: var(--accent); font-size: 3em; margin: 0 0 15px 0;">🎖️</h3>
                        <h4 data-i18n="integridade" style="color: var(--text-primary); font-size: 1.1em; font-weight: 900; margin: 0 0 10px 0; text-transform: uppercase;">Integridade</h4>
                        <p data-i18n="integridadeDesc" style="color: var(--text-secondary); font-size: 0.95em; line-height: 1.6; margin: 0;">Agir com honestidade em cada transação</p>
                    </div>
                    <div style="text-align: center;">
                        <h3 style="color: var(--accent); font-size: 3em; margin: 0 0 15px 0;">🔥</h3>
                        <h4 data-i18n="paixao" style="color: var(--text-primary); font-size: 1.1em; font-weight: 900; margin: 0 0 10px 0; text-transform: uppercase;">Paixão</h4>
                        <p data-i18n="paixaoDesc" style="color: var(--text-secondary); font-size: 0.95em; line-height: 1.6; margin: 0;">Amar o que fazemos genuinamente</p>
                    </div>
                    <div style="text-align: center;">
                        <h3 style="color: var(--accent); font-size: 3em; margin: 0 0 15px 0;">🌍</h3>
                        <h4 data-i18n="inclusao" style="color: var(--text-primary); font-size: 1.1em; font-weight: 900; margin: 0 0 10px 0; text-transform: uppercase;">Inclusão</h4>
                        <p data-i18n="inclusaoDesc" style="color: var(--text-secondary); font-size: 0.95em; line-height: 1.6; margin: 0;">Servir a comunidade sem limites</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Seção 5: CTA Final -->
        <section style="background: linear-gradient(135deg, rgba(220,53,69,0.15) 0%, rgba(30,144,255,0.15) 100%); padding: 60px; border-radius: 8px; text-align: center; border: 2px solid var(--accent);">
            <h2 data-i18n="prontoDescobrir" style="color: var(--text-primary); font-size: 2em; font-weight: 900; margin: 0 0 20px 0; text-transform: uppercase;">
                Pronto para Descobrir Novos Mangás?
            </h2>
            <p data-i18n="prontoDescubrirDesc" style="color: var(--text-secondary); font-size: 1.1em; margin: 0 0 30px 0;">
                Junte-se à comunidade OTAKON e explore um mundo de histórias épicas
            </p>
            <a href="/Account/Register" data-i18n="comecaAgora" style="background: var(--accent); color: white; padding: 16px 50px; text-decoration: none; font-weight: 900; font-size: 1em; display: inline-block; border-radius: 6px; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s ease;">
                Começar Agora
            </a>
        </section>

    </div>
</div>

<style>
    @@media (max-width: 768px) {
        h2 {
            font-size: 1.8em !important;
        }

        div[style*="grid-template-columns: 1fr 1fr"] {
            grid-template-columns: 1fr !important;
        }

        div[style*="grid-template-columns: 1fr 1fr 1fr"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>
