@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section">
    <div class="text-center">
        <img src="~/images/OTAKON - Cópia.png" alt="OTAKON Logo" class="mb-5" style="max-width: 450px; height: auto; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.1)); animation: bounceIn 0.8s ease;" />

        <h1 class="display-3 mb-3" style="color: #1a1a1a;">Bem-vindo(a)</h1>

        <div style="display: flex; justify-content: center; gap: 15px; margin-bottom: 30px;">
            <div style="width: 100px; height: 3px; background: linear-gradient(90deg, transparent, #dc3545); margin-top: 10px;"></div>
            <div style="font-size: 20px;">📖</div>
            <div style="width: 100px; height: 3px; background: linear-gradient(90deg, #dc3545, transparent); margin-top: 10px;"></div>
        </div>

        <p class="lead" style="color: #555; font-size: 18px; line-height: 1.8; margin-bottom: 20px;">
            À plataforma <strong>OTAKON</strong> - Sua comunidade de anime e cultura geek
        </p>

        <p style="color: #999; font-size: 14px; font-style: italic; margin-bottom: 40px;">
            O melhor lugar para ler, compartilhar e descobrir histórias incríveis
        </p>

        <div style="margin: 40px 0;">
            <a href="/Account/Login" class="btn" style="background: linear-gradient(135deg, #dc3545, #c82333); color: white; padding: 14px 40px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 16px; display: inline-block; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);">
                Comece Agora →
            </a>
        </div>

        <p style="color: #ccc; margin-top: 50px; padding-top: 30px; border-top: 1px solid #f0f0f0;">
            Aprenda mais sobre <a href="https://learn.microsoft.com/aspnet/core" style="color: #dc3545; font-weight: 600;">building Web apps with ASP.NET Core</a>
        </p>
    </div>
</div>

<!-- Garoto Propaganda Section -->
<section style="background: linear-gradient(135deg, #f9f9f9 0%, #ffffff 100%); padding: 80px 20px; position: relative; overflow: hidden;">
    <!-- Background decoration -->
    <div style="position: absolute; top: -50px; right: -50px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(220, 53, 69, 0.05) 0%, transparent 70%); border-radius: 50%;"></div>
    <div style="position: absolute; bottom: -100px; left: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(220, 53, 69, 0.03) 0%, transparent 70%); border-radius: 50%;"></div>

    <div class="container" style="position: relative; z-index: 1; max-width: 1000px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;" class="ambassador-grid">
            <!-- Imagem -->
            <div style="text-align: center;">
                <div style="position: relative; display: inline-block;">
                    <div style="position: absolute; inset: -15px; background: linear-gradient(135deg, #dc3545, #c82333); border-radius: 20px; filter: blur(20px); opacity: 0.3; animation: pulse 3s ease-in-out infinite;"></div>
                    <img src="~/images/gajo.jpg" alt="Garoto Propaganda OTAKON" style="max-width: 100%; height: auto; border-radius: 15px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15); position: relative; z-index: 1; max-height: 500px; object-fit: cover;" />
                </div>
            </div>

            <!-- Conteúdo -->
            <div style="display: flex; flex-direction: column; gap: 25px;">
                <div>
                    <span style="color: #dc3545; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 2px;">Nosso Rosto</span>
                    <h2 style="color: #1a1a1a; font-size: 36px; font-weight: 700; margin: 10px 0; line-height: 1.2;">
                        Conheça nosso<br />Garoto Propaganda Thundercat
                    </h2>
                    <p style="color: #dc3545; font-size: 18px; font-weight: 600; margin-top: 15px; font-style: italic;">
                        "Isso é jazz cósmico"
                    </p>
                </div>

                <p style="color: #666; font-size: 16px; line-height: 1.8; margin: 0;">
                    O rosto da comunidade OTAKON. Um verdadeiro fã de anime, mangá e cultura geek.
                </p>

                <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 20px;">
                    <a href="/Account/Login" style="background: linear-gradient(135deg, #dc3545, #c82333); color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);">
                        Fazer Login
                    </a>
                    <a href="/Account/Register" style="background: white; color: #dc3545; padding: 12px 30px; border-radius: 8px; border: 2px solid #dc3545; text-decoration: none; font-weight: 600; transition: all 0.3s ease;">
                        Criar Conta
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Chamada Final -->
<section style="background: white; padding: 60px 20px; text-align: center;">
    <div class="container" style="max-width: 600px;">
        <h2 style="color: #1a1a1a; font-size: 32px; font-weight: 700; margin-bottom: 20px;">
            Pronto para se juntar à comunidade?
        </h2>
        <p style="color: #666; font-size: 16px; line-height: 1.8; margin-bottom: 30px;">
            Faça parte da maior comunidade de mangá do Brasil. Leia, compartilhe e descubra novas histórias.
        </p>
        <a href="/Account/Login" style="background: linear-gradient(135deg, #dc3545, #c82333); color: white; padding: 16px 50px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 18px; display: inline-block; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);">
            Entrar Agora
        </a>
    </div>
</section>
}
</style>
