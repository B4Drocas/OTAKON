@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<div class="otakon-hero">
    <div class="otakon-hero-content">
        <img src="~/images/OTAKON - Cópia.png" alt="OTAKON Logo" class="mb-5" style="max-width: 450px; height: auto; animation: bounceIn 0.8s ease;" />

        <h1 data-i18n="bemvindo" style="color: var(--text-primary); font-size: 3em;">
            BEM-VINDO(A)
        </h1>

        <div style="display: flex; justify-content: center; gap: 15px; margin-bottom: 30px;">
            <div style="width: 100px; height: 3px; background: linear-gradient(90deg, transparent, var(--accent)); margin-top: 10px;"></div>
            <div style="font-size: 20px;">📖</div>
            <div style="width: 100px; height: 3px; background: linear-gradient(90deg, var(--accent), transparent); margin-top: 10px;"></div>
        </div>

        <p style="color: var(--text-secondary); font-size: 1.3em; line-height: 1.8; margin-bottom: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
            <span data-i18n="subtitulo">À plataforma</span> <strong style="color: var(--accent);" data-i18n="otakonTitle">OTAKON</strong>
        </p>

        <p data-i18n="descricao" style="color: var(--text-tertiary); font-size: 1.1em; margin-bottom: 40px; font-style: italic;">
            Sua comunidade de anime, mangá e cultura geek brutal
        </p>

        <div style="margin: 40px 0;">
            <a href="/Account/Login" class="otakon-button" data-i18n="fazerLogin">
                Fazer Login →
            </a>
        </div>

        <p style="color: var(--text-tertiary); margin-top: 50px; padding-top: 30px; border-top: 1px solid var(--border-color);">
            Aprenda mais sobre <a href="https://learn.microsoft.com/aspnet/core" style="color: var(--accent); font-weight: 900;">building Web apps with ASP.NET Core</a>
        </p>
    </div>
</div>

<!-- Garoto Propaganda Section -->
<section style="background: var(--bg-secondary); padding: 80px 20px; position: relative; overflow: hidden; border-top: 2px solid var(--accent); border-bottom: 2px solid var(--accent);">
    <!-- Background decoration -->
    <div style="position: absolute; top: -50px; right: -50px; width: 300px; height: 300px; border-radius: 50%;"></div>
    <div style="position: absolute; bottom: -100px; left: -100px; width: 400px; height: 400px; border-radius: 50%;"></div>

    <div class="container" style="position: relative; z-index: 1; max-width: 1000px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;" class="ambassador-grid">
            <!-- Imagem -->
            <div style="text-align: center;">
                <div style="position: relative; display: inline-block;">
                    <div style="position: absolute; inset: -15px; background: linear-gradient(135deg, var(--accent), #c82333); border-radius: 20px; filter: blur(20px); opacity: 0.3; animation: pulse 3s ease-in-out infinite;"></div>
                    <img src="~/images/gajo.jpg" alt="Garoto Propaganda OTAKON" style="max-width: 100%; height: auto; border-radius: 15px; box-shadow: 0 20px 50px rgba(220, 53, 69, 0.3); position: relative; z-index: 1; max-height: 500px; object-fit: cover; border: 3px solid var(--accent);" />
                </div>
            </div>

            <!-- Conteúdo -->
            <div style="display: flex; flex-direction: column; gap: 25px;">
                <div>
                    <span data-i18n="nossoRosto" style="color: var(--accent); font-weight: 900; font-size: 0.85em; text-transform: uppercase; letter-spacing: 2px;">
                        ⭐ Nosso Rosto
                    </span>
                    <h2 style="color: var(--text-primary); font-size: 2.5em; font-weight: 900; margin: 15px 0; line-height: 1.2; text-transform: uppercase; letter-spacing: -1px;">
                        <span data-i18n="conhecaNosso">Conheça nosso</span><br />
                        <span data-i18n="garotoPropaganda">Garoto Propaganda Thundercat</span>
                    </h2>
                    <p style="color: var(--accent); font-size: 1.3em; font-weight: 900; margin-top: 15px; font-style: italic;">
                        <span data-i18n="garotoPropagandaQuote">"Isso é jazz cósmico"</span>
                    </p>
                </div>

                <p data-i18n="garotoPropagandaDesc" style="color: var(--text-secondary); font-size: 1.1em; line-height: 1.8; margin: 0; font-weight: 600; letter-spacing: 0.3px;">
                    O rosto da comunidade OTAKON. Um verdadeiro fã de anime, mangá e cultura geek. Símbolo da brutalidade e paixão que define tudo que fazemos.
                </p>

                <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 20px;">
                    <a href="/Account/Register" style="background: linear-gradient(135deg, var(--accent), #c82333); color: white; padding: 14px 35px; border-radius: 6px; text-decoration: none; font-weight: 900; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 1px;" data-i18n="criarContaBtn">
                        Criar Conta
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Chamada Final -->
<section style="background: var(--bg-primary); padding: 80px 20px; text-align: center; border-top: 3px solid var(--accent);">
    <div class="container" style="max-width: 600px;">
        <h2 data-i18n="prontoParaComunidade" style="color: var(--text-primary); font-size: 2.2em; font-weight: 900; margin-bottom: 25px; text-transform: uppercase; letter-spacing: -1px;">
            Pronto para a Comunidade?
        </h2>
        <p data-i18n="mensagemComunidade" style="color: var(--text-secondary); font-size: 1.1em; line-height: 1.8; margin-bottom: 40px; font-weight: 600;">
            Faça parte do movimento OTAKON. Leia, compartilhe e descubra histórias épicas de mangá.
        </p>
        <a href="/Account/Register" style="background: linear-gradient(135deg, var(--accent), #c82333); color: white; padding: 16px 50px; border-radius: 6px; text-decoration: none; font-weight: 900; font-size: 1em; display: inline-block; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 1px;" data-i18n="entrarAgora">
            Entrar Agora
        </a>
    </div>
</section>
